# Neon PostgreSQL Connection URL (sslmode=require is mandatory for Neon)
DATABASE_URL=postgresql://<user>:<password>@<ep-id>.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for signing authentication tokens
JWT_SECRET=replace_with_a_secure_random_string_32_chars_plus

# Allowed Frontend URL(s) for CORS (comma-separated if multiple, no trailing slash)
FRONTEND_URL=https://your-sudomus-app.vercel.app

# Server Port (Render sets this automatically in production)
PORT=5000

# Anthropic Claude AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Cloudinary configuration for listing image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Session secret
SESSION_SECRET=replace_with_a_secure_random_session_secret

# Nylas Transactional Send Configuration
NYLAS_API_KEY=your_nylas_api_key_here
NYLAS_EMAIL_DOMAIN=sudomus.nylas.email
NYLAS_FROM_EMAIL=no-reply@sudomus.nylas.email
NYLAS_FROM_NAME=SuDomus
